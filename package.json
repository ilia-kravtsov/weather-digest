{
  "name": "weather-digest",
  "version": "1.0.0",
  "description": "Console weather digest utility using Open-Meteo API",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"docs/report-viewer/**/*.{html,js,css}\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"docs/report-viewer/**/*.{html,js,css}\" \"*.json\" \"*.md\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilia-kravtsov/weather-digest.git"
  },
  "keywords": [],
  "author": "ilia-kravtsov",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ilia-kravtsov/weather-digest/issues"
  },
  "homepage": "https://github.com/ilia-kravtsov/weather-digest#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
